# ── Website form email (contact form + trip planner) ─────────────────────
# Copy to .env.local (development) or set in your hosting dashboard (production).
# Use the SMTP details of the mailbox that should send the website's emails,
# e.g. info@flairtravels.com on your email host.

# SMTP server. Common examples:
#   cPanel / web host:   mail.flairtravels.com      port 465
#   Google Workspace:    smtp.gmail.com             port 465 (use an App Password)
#   Microsoft 365:       smtp.office365.com         port 587
#   Zoho Mail:           smtp.zoho.com              port 465
SMTP_HOST=mail.flairtravels.com
SMTP_PORT=465
# true for port 465 (implicit TLS), false for 587 (STARTTLS). Inferred from the port if omitted.
SMTP_SECURE=true
SMTP_USER=info@flairtravels.com
SMTP_PASS=

# Where enquiries are delivered (defaults to info@flairtravels.com).
MAIL_TO=info@flairtravels.com
# Sender shown on the emails; must be an address your SMTP account may send as.
MAIL_FROM="Flair Travels website <info@flairtravels.com>"
